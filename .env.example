# Copy this file to ".env" and fill in what you need. Everything is optional.

# Lets Claude understand free, messy speech in any language.
# Without it, the built-in rules are used.
ANTHROPIC_API_KEY=

# Fastest current model; good for short classification and extraction.
# CLAUDE_MODEL=claude-haiku-5-5
# If Claude takes longer than this, the built-in rules answer instead.
# CLAUDE_TIMEOUT_MS=6000

# PORT=3000
# DEMO_PIN=1234
# Most money (in EUR) that one voice transfer may send. The helper can change it in the app.
# VOICE_LIMIT_EUR=300
# How long a transfer stays "on its way" before it shows as arrived.
# ARRIVAL_DELAY_MS=4000

# Wise Help Centre answers. The app reads the public article on wise.com/help
# when it can; set to 0 to use only the built-in summaries.
# HELP_LIVE_FETCH=1
# WISE_HELP_BASE_URL=https://wise.com
# HELP_TIMEOUT_MS=5000

# Where the owner's voice fingerprint is kept (numbers only, never audio).
# VOICEPRINT_FILE=.data/voiceprint.json
